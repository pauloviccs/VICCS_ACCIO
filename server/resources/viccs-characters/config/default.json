{
    "$schema": "viccs-config",
    "$resource": "viccs-characters",
    "$version": "1.0.0",
    "$description": "Perfis RP, catalogo canonico de varinhas e ponte opcional com fichas aprovadas no Supabase.",

    "featureToggles": {
        "enabled": true,
        "debugMode": false,
        "supabaseSync": false,
        "requireWhitelistVerification": false,
        "allowAssertedDiscordInDev": true,
        "autoApplyHouseFromWhitelist": false,
        "autoShowSheetAfterSorting": true,
        "showControlsIntroAfterOnboarding": true,
        "enablePlayerCommands": false
    },

    "houseRobes": {
        "autoApplyOnSorting": true,
        "restoreOnCharacterLoaded": true,
        "applyUnaffiliatedOnJoin": true,
        "outfitItemId": "Outfit_001_Basic",
        "backItemId": "Back_001_Basic"
    },

    "defaults": {
        "startingAcademicYear": 1,
        "defaultBloodStatus": "half-blood",
        "defaultBirthPlace": "Grã-Bretanha",
        "defaultWand": {
            "wood": "Carvalho Inglês",
            "core": "Pena de Fênix",
            "length": "11 polegadas",
            "flexibility": "Firme",
            "handleId": "imperial-brown-gold"
        }
    },

    "supabase": {
        "// nota": "Configure url e serviceRoleKey apenas em server/data/viccs-characters.json ou via env VICCS_SUPABASE_URL / VICCS_SUPABASE_SERVICE_KEY.",
        "url": "",
        "serviceRoleKey": "",
        "timeoutMs": 6000
    },

